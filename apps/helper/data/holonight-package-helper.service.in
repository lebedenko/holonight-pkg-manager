[Unit]
Description=HoloNight Packages privileged transaction helper

[Service]
Type=dbus
BusName=org.holonight.PackageHelper1
ExecStart=@HOLONIGHT_HELPER_EXECUTABLE@
SyslogIdentifier=holonight-package-helper
StandardOutput=journal
StandardError=journal
KillMode=mixed
TimeoutStopSec=300

# pacman installs files anywhere, ships setuid files, runs arbitrary hook tools, downloads over the network and calls
# chroot, so only the protections that cannot get in its way are set.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

# The system upgrade keeps its private copy of the sync databases under /var/lib/holonight-package-helper. 0711 lets
# libalpm's download sandbox (DownloadUser) reach its own download directory below it, but no one can list it.
StateDirectory=holonight-package-helper
StateDirectoryMode=0711
