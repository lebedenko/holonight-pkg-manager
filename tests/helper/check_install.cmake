# Installs the build into a temporary DESTDIR and checks the holonight-package-helper artifacts (DESIGN 11.5).
# Usage: cmake -DBUILD_DIR=<dir> -DSTAGE_DIR=<dir> -DINSTALL_PREFIX=<configured-prefix> -P check_install.cmake
if(NOT DEFINED INSTALL_PREFIX)
  message(FATAL_ERROR "INSTALL_PREFIX must match the configured build prefix")
endif()
file(REMOVE_RECURSE "${STAGE_DIR}")
file(MAKE_DIRECTORY "${STAGE_DIR}")
execute_process(
  COMMAND ${CMAKE_COMMAND} -E env "DESTDIR=${STAGE_DIR}" ${CMAKE_COMMAND} --install "${BUILD_DIR}" --prefix "${INSTALL_PREFIX}"
  RESULT_VARIABLE install_result OUTPUT_QUIET ERROR_VARIABLE install_error)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "install into DESTDIR failed: ${install_error}")
endif()

set(root "${STAGE_DIR}${INSTALL_PREFIX}")
set(binary "${root}/libexec/holonight-package-helper")
set(policy "${root}/share/polkit-1/actions/org.holonight.packages.policy")
set(bus_conf "${root}/share/dbus-1/system.d/org.holonight.PackageHelper1.conf")
set(activation "${root}/share/dbus-1/system-services/org.holonight.PackageHelper1.service")
set(unit "${root}/lib/systemd/system/holonight-package-helper.service")
set(interface_xml "${root}/share/dbus-1/interfaces/org.holonight.PackageHelper1.xml")
foreach(path IN ITEMS "${binary}" "${policy}" "${bus_conf}" "${activation}" "${unit}" "${interface_xml}")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "missing from install stage: ${path}")
  endif()
endforeach()

file(READ "${activation}" activation_text)
file(READ "${unit}" unit_text)
if(NOT unit_text MATCHES "Type=dbus")
  message(FATAL_ERROR "unit is not Type=dbus")
endif()
if(NOT activation_text MATCHES "Name=([^\n]+)\n")
  message(FATAL_ERROR "activation file has no Name=")
endif()
set(bus_name "${CMAKE_MATCH_1}")
if(NOT unit_text MATCHES "BusName=${bus_name}\n")
  message(FATAL_ERROR "unit BusName does not match the activation Name ${bus_name}")
endif()
if(NOT activation_text MATCHES "SystemdService=holonight-package-helper.service")
  message(FATAL_ERROR "the activation file does not point at the systemd unit")
endif()
if(NOT activation_text MATCHES "User=root")
  message(FATAL_ERROR "the activation file does not run the helper as root")
endif()
string(FIND "${unit_text}" "ExecStart=${INSTALL_PREFIX}/libexec/holonight-package-helper\n" exec_offset)
if(exec_offset EQUAL -1)
  message(FATAL_ERROR "the unit does not execute the installed helper under the prefix")
endif()
foreach(text IN ITEMS "${activation_text}" "${unit_text}")
  string(FIND "${text}" "${STAGE_DIR}" stage_offset)
  if(NOT stage_offset EQUAL -1)
    message(FATAL_ERROR "an artifact leaks the staging directory")
  endif()
endforeach()
